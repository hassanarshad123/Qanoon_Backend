# === Required ===
DATABASE_URL=postgresql://user:pass@host/dbname
AUTH_SECRET=your-nextauth-secret-here
ANTHROPIC_API_KEY=sk-ant-...

# === Sentry (optional — error tracking) ===
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# === Optional (degrade gracefully) ===
VOYAGE_API_KEY=pa-...
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# SMTP (password reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_FROM=noreply@qanoon.ai

# AWS S3 (replaces Vercel Blob)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=qanoonai-uploads
AWS_S3_REGION=ap-south-1

# Frontend URL (used in emails)
FRONTEND_URL=https://qanoon.ai

# CORS
# Development:
CORS_ORIGINS=http://localhost:3000
# EC2 production (replace with your actual domains):
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
